# Copy this file to .env.local and fill in real values.
# Nothing here is committed with real secrets — Vite only exposes VITE_-prefixed vars to the client.

# Formspree or Web3Forms endpoint for the contact form (see README for setup steps)
VITE_FORM_ENDPOINT=

# Calendly or Cal.com scheduling link
VITE_CALENDLY_URL=

# Optional analytics — set one or both. Leave blank to disable analytics entirely.
VITE_GA_MEASUREMENT_ID=
VITE_PLAUSIBLE_DOMAIN=
